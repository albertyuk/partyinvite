# ─────────────────────────────────────────────────────────────────────────────
# Peninsula Residence Invitation — environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client.
# ─────────────────────────────────────────────────────────────────────────────

# Mapbox public access token (starts with "pk."). URL-restrict it in the
# Mapbox dashboard to your deploy domain. If absent, the cinematic intro
# gracefully falls back to a static hero — the site still works.
VITE_MAPBOX_TOKEN=

# Google Apps Script web-app endpoint (the "…/exec" URL) that appends RSVPs
# to the host's private Google Sheet. If absent, RSVPs are stored locally and
# the pass still renders — the Sheet write is simply skipped.
VITE_RSVP_ENDPOINT=
